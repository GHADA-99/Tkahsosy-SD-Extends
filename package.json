{
  "name": "medsync",
  "version": "1.0.0",
  "description": "MedSync Medical Synchronization Platform – SAP CAP v9 application",
  "dependencies": {
    "@sap/cds": "^9"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2",
    "jest": "^29"
  },
  "scripts": {
    "start"  : "cds-serve",
    "watch"  : "cds watch",
    "build"  : "cds build/all",
    "test"   : "jest --testPathPattern=test/",
    "deploy" : "cds deploy --to sqlite:db/medsync.db",
    "lint"   : "eslint srv/ --ext .js"
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": { "url": "db/medsync.db" }
      }
    },
    "features": {
      "serve_on_root": false
    }
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/test/**/*.test.js"]
  },
  "private": true
}
