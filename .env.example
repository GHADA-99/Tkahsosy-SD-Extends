# ─── MedSync Environment Variables ───────────────────────────────────────────
# Copy this file to .env and fill in the values for your environment.
# Never commit the actual .env file to version control.

# ── Node.js ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4004

# ── CAP / CDS ────────────────────────────────────────────────────────────────
# Override the CDS profile. Options: development, production
CDS_ENV=development

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (development – default, no config needed)
# For HANA Cloud (production):
# VCAP_SERVICES={"hana":[{"name":"medsync-db","credentials":{...}}]}

# ── Authentication (SAP BTP XSUAA) ───────────────────────────────────────────
# Required for production deployment on SAP BTP.
# Leave empty for local mock-auth development.
# VCAP_SERVICES={"xsuaa":[{"name":"medsync-auth","credentials":{"clientid":"...","clientsecret":"...","url":"..."}}]}

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info
# Options: silent, error, warn, info, verbose, debug, silly

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:4004

# ── Email / Notifications (optional) ─────────────────────────────────────────
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=medsync@example.com
# SMTP_PASS=your-smtp-password
# NOTIFICATION_EMAIL_FROM=no-reply@medsync.example.com

# ── Security ──────────────────────────────────────────────────────────────────
# JWT_SECRET=replace-this-with-a-strong-random-secret-at-least-32-chars
# SESSION_SECRET=replace-this-with-another-strong-random-secret

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_AUDIT_LOGGING=true
ENABLE_EMAIL_NOTIFICATIONS=false
MAX_APPOINTMENTS_PER_DAY=20
NOTIFICATION_RETENTION_DAYS=90
